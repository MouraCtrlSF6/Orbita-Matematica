{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('meta/ownerUid').val() === auth.uid",
        ".write": "auth != null && data.child('meta/ownerUid').val() === auth.uid && !newData.exists()",
        "meta": {
          ".write": "auth != null && newData.exists() && (!data.exists() || data.child('ownerUid').val() === auth.uid) && newData.child('ownerUid').val() === auth.uid",
          ".validate": "newData.hasChildren(['open', 'ownerUid'])",
          "open": { ".read": "auth != null", ".validate": "newData.isBoolean()" },
          "ownerUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "$other": { ".validate": false }
        },
        "students": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('meta/open').val() === true && newData.exists()",
            ".validate": "newData.hasChildren(['studentId', 'name', 'sectors'])",
            "studentId": { ".validate": "newData.isString() && newData.val() === $uid" },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100 && (!data.exists() || newData.val() === data.val())"
            },
            "currentSector": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
            },
            "sectors": {
              "$sectorId": {
                ".validate": "newData.hasChildren(['sectorName', 'sectorStatus', 'missions'])",
                "sectorName": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
                },
                "sectorStatus": {
                  ".validate": "newData.val() === 'not_started' || newData.val() === 'in_progress' || newData.val() === 'completed'"
                },
                "missions": {
                  "$missionId": {
                    ".validate": "newData.hasChildren(['missionNumber', 'missionStatus', 'usedHints', 'usedVisuals'])",
                    "missionNumber": {
                      ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0"
                    },
                    "missionStatus": {
                      ".validate": "newData.val() === 'not_started' || newData.val() === 'in_progress' || newData.val() === 'completed'"
                    },
                    "usedHints": { ".validate": "newData.isBoolean()" },
                    "usedVisuals": { ".validate": "newData.isBoolean()" },
                    "providedAnswers": {
                      "$attemptId": {
                        ".validate": "newData.hasChildren(['order', 'answer', 'correct'])",
                        "order": {
                          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() % 1 === 0 && $attemptId === 'attempt-' + newData.val()"
                        },
                        "answer": {
                          ".validate": "newData.hasChildren(['label', 'value'])",
                          "label": {
                            ".validate": "newData.isString() && newData.val().length > 0"
                          },
                          "value": {
                            ".validate": "newData.isString() && newData.val().length > 0"
                          },
                          "$other": { ".validate": false }
                        },
                        "correct": { ".validate": "newData.isBoolean()" },
                        "context": {
                          ".validate": "newData.isString() && newData.val().length > 0"
                        },
                        "variable": { ".validate": "newData.isNumber()" },
                        "$other": { ".validate": false }
                      }
                    },
                    "$other": { ".validate": false }
                  }
                },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
